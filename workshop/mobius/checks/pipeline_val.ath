# pipeline_val.ath: a separate restatement of the five "claim worlds" lines of pipeline.ath.
# pipeline.ath is kept as it was run: those five lines printed FALSE ("P has no valuation"), and that result stands.
# Here the same frames carry a valuation (atom c = the coordinator stop), so asteroid will evaluate "claim worlds".
# Run: bin/asteroid --no-lean workshop/mobius/checks/pipeline_val.ath
# Stops: 0 coordinator, 1 bus.ath, 2 laws.ath, 3 general.ath (workshop/bus/). Spec: workshop/mobius/SPEC.md (b), (c).
kripke P = worlds 4 rel [(0,1), (1,2), (2,3)] val c {0}
kripke Pin = worlds 4 rel [(1,0), (2,1), (3,2)] val c {0}

# V1 (= O2). No walk of 4 pushes, either way: no cycle, no stop visited twice.
claim worlds P "[][][][]F" = {0,1,2,3}
claim worlds Pin "[][][][]F" = {0,1,2,3}
# V2 (= O3). A walk of 3 pushes exists only from the coordinator: with V1 it visits all 4 stops once, in order.
claim worlds P "<><><>T" = {0}
# V3 (= O5). Stops 0, 1, 2 have an output; stops 1, 2, 3 have an input.
claim worlds P "<>T" = {0,1,2}
claim worlds Pin "<>T" = {1,2,3}
# V4. Walking back 3 pushes from the last bus reaches the coordinator.
claim worlds Pin "<><><>c" = {3}
