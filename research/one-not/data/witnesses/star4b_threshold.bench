# star4b_threshold: 4 inputs, 3 sets, 14 gates, 1 NOT gate
INPUT(x0)
INPUT(x1)
INPUT(x2)
INPUT(x3)
OUTPUT(g11)
OUTPUT(g12)
OUTPUT(g13)
#@ or g11 = x0 x1
#@ or g12 = x0 x2
#@ or g13 = x0 x3
g0 = OR(x1, x2)
g1 = AND(x1, x2)
g2 = AND(g0, x3)
g3 = OR(g1, g2)
g4 = NOT(g3)
g5 = OR(g0, x3)
g6 = AND(g4, g5)
g7 = AND(g1, x3)
g8 = OR(g6, g7)
g9 = OR(g8, x0)
g10 = OR(g3, x0)
g11 = OR(x0, x1)
g12 = OR(x0, x2)
g13 = OR(x0, x3)
