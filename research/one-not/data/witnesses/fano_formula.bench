# fano_formula: 7 inputs, 7 sets, 17 gates, 1 NOT gate
INPUT(x0)
INPUT(x1)
INPUT(x2)
INPUT(x3)
INPUT(x4)
INPUT(x5)
INPUT(x6)
OUTPUT(g4)
OUTPUT(g6)
OUTPUT(g8)
OUTPUT(g10)
OUTPUT(g12)
OUTPUT(g14)
OUTPUT(g16)
#@ or g4 = x0 x1 x2
#@ or g6 = x0 x3 x4
#@ or g8 = x0 x5 x6
#@ or g10 = x1 x3 x5
#@ or g12 = x1 x4 x6
#@ or g14 = x2 x3 x6
#@ or g16 = x2 x4 x5
g0 = AND(x0, x1)
g1 = AND(g0, x2)
g2 = NOT(g1)
g3 = OR(x1, x2)
g4 = OR(g3, x0)
g5 = OR(x0, x4)
g6 = OR(g5, x3)
g7 = OR(x0, x6)
g8 = OR(g7, x5)
g9 = OR(x3, x5)
g10 = OR(g9, x1)
g11 = OR(x1, x6)
g12 = OR(g11, x4)
g13 = OR(x2, x3)
g14 = OR(g13, x6)
g15 = OR(x4, x5)
g16 = OR(g15, x2)
