import PEqualNP.W951.PureSDR

/-!
# PureSDRWitnessLadder: kernel-checked PureSDR certificates for scaffold's instances

Generated by `951/tools/sdrcert/pure_export.py --group witness` (Python finds, Lean checks), in the
format of `PureSDRWitness.lean`: one pure option per set, checked valid (`PureValid`, `decide`), its
class recomputed in the lift (`pureCls`, `decide`) and equal to a literal, the literals pairwise
disjoint, so `PureSDR S gates p` holds. The group `witness` is every `*.json` in `951/data/witnesses`;
scaffold's v-ladder instances (Fano, AG(2,3), PG(2,3), AG(2,4), ...) go in the same way once they are
in the repository.

* paschS14HeavyAtmostone (scaffold 10:46, via desktop Coord; `n = 6`, `s = 14`): the pure SDR puts
  the sets `{0,3,4}` and `{2,4,5}` BOTH in world 0 through the heavy point `4` (`h = x1 ∨ x4`,
  `h(e_4) = 1`), refuting the heavy-star rule "at most one world-0 set per heavy point". Scaffold
  reports this pure SDR as the only one (Python). Kernel-checked here: the PureSDR, the correctness of
  the circuit (each output is `OR (S w)`, all `2^6` inputs), the 951 set conditions, and that point
  `4` is heavy.
-/

namespace PEqualNP.Outside.L_meta_951_aux

open PEqualNP.CircuitLowerBounds

/-! ### paschS14HeavyAtmostone: n = 6, 14 gates (NOT gate 1), 4 sets; worlds I1, I0, I1, I0 -/

def pPaschS14HeavyAtmostoneGates : List Gate := [⟨GateOp.or, [1, 4]⟩, ⟨GateOp.not, [6]⟩, ⟨GateOp.or, [1, 7]⟩, ⟨GateOp.and, [6, 8]⟩, ⟨GateOp.or, [3, 9]⟩, ⟨GateOp.or, [0, 3]⟩, ⟨GateOp.or, [4, 8]⟩, ⟨GateOp.or, [2, 9]⟩, ⟨GateOp.or, [2, 5]⟩, ⟨GateOp.or, [0, 13]⟩, ⟨GateOp.and, [12, 15]⟩, ⟨GateOp.or, [4, 11]⟩, ⟨GateOp.or, [5, 10]⟩, ⟨GateOp.or, [4, 14]⟩]
def pPaschS14HeavyAtmostoneS : Fin 4 → Finset (Fin 6) := ![{0, 1, 2}, {0, 3, 4}, {1, 3, 5}, {2, 4, 5}]
def pPaschS14HeavyAtmostoneC : Fin 4 → PureOpt 6 := ![PureOpt.one (canonPt {}), PureOpt.zero ![{1}, {}, {}, {1}, {1}, {}], PureOpt.one (canonPt {}), PureOpt.zero ![{}, {}, {1}, {}, {1}, {1}]]
def pPaschS14HeavyAtmostoneM : Fin 4 → Finset ℕ := ![{13, 15}, {11, 17}, {10, 18}, {14, 19}]

set_option maxRecDepth 100000 in
theorem pPaschS14HeavyAtmostone_valid : ∀ w, PureValid pPaschS14HeavyAtmostoneGates 1 (pPaschS14HeavyAtmostoneS w) (pPaschS14HeavyAtmostoneC w) := by decide

set_option maxRecDepth 100000 in
theorem pPaschS14HeavyAtmostone_cls : ∀ w, pureCls pPaschS14HeavyAtmostoneGates 1 (pPaschS14HeavyAtmostoneS w) (pPaschS14HeavyAtmostoneC w) = pPaschS14HeavyAtmostoneM w := by decide

theorem pPaschS14HeavyAtmostone : PureSDR pPaschS14HeavyAtmostoneS pPaschS14HeavyAtmostoneGates 1 :=
  pureSDR_of_cert _ _ _ pPaschS14HeavyAtmostoneC pPaschS14HeavyAtmostoneM pPaschS14HeavyAtmostone_valid pPaschS14HeavyAtmostone_cls (by decide)

def pPaschS14HeavyAtmostoneOut : Fin 4 → ℕ := ![16, 17, 18, 19]

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 100000 in
/-- Pasch, `s = 14`: correct, (1,1)-disjoint sets of size at least 2, PureSDR, the NOT gate (gate 1)
reads `h = x1 ∨ x4` (wire 6), and `h(e_4) = 1`. The PureSDR's options for the sets `{0,3,4}` (set 1)
and `{2,4,5}` (set 3) are both world 0 (`PureOpt.zero`, see `pPaschS14HeavyAtmostoneC`). -/
theorem pPaschS14HeavyAtmostone_correct :
    (∀ (w : Fin 4) (x : Fin 6 → Bool),
      val pPaschS14HeavyAtmostoneGates x (pPaschS14HeavyAtmostoneOut w) =
        decide (∃ v ∈ pPaschS14HeavyAtmostoneS w, x v = true)) ∧
    (∀ w, 2 ≤ (pPaschS14HeavyAtmostoneS w).card) ∧
    (∀ a b : Fin 4, a ≠ b →
      (pPaschS14HeavyAtmostoneS a ∩ pPaschS14HeavyAtmostoneS b).card ≤ 1) ∧
    PureSDR pPaschS14HeavyAtmostoneS pPaschS14HeavyAtmostoneGates 1 ∧
    pPaschS14HeavyAtmostoneGates[1]? = some ⟨GateOp.not, [6]⟩ ∧
    val pPaschS14HeavyAtmostoneGates (eof (4 : Fin 6)) 6 = true ∧
    (4 : Fin 6) ∈ pPaschS14HeavyAtmostoneS 1 ∧ (4 : Fin 6) ∈ pPaschS14HeavyAtmostoneS 3 :=
  ⟨by decide, by decide, by decide, pPaschS14HeavyAtmostone, rfl, by decide, by decide,
    by decide⟩

end PEqualNP.Outside.L_meta_951_aux
