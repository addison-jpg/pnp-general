import PEqualNP.W951.MergeSDR

/-! SDRCert: kernel-checked MergeSDR certificates for concrete circuits (coord, one-not/PIPELINE.md:
Python finds a small witness, the kernel checks it with plain `decide`).

A certificate for a circuit is one zero point `z w` per set and the merge set `M w` there, written
as literals. `mergeSDR_of_cert` turns three finite checks into `MergeSDR`:
* every `z w` vanishes on its set;
* `mergeSet gates (S w) (z w) = M w`: the kernel recomputes the union-find run of `mergeSet` on the
  circuit (nothing from Python is trusted);
* the literal sets `M w` are pairwise disjoint.
The witnesses (`SDRWitness.lean`, generated by `one-not/tools/sdrcert/export.py`) cover the hardest known
circuits: Config (I), ADV3, ADV4, scaffold's payment/ce3, HARD4 and cxr. -/

namespace PEqualNP.Outside.L_meta_951_aux

open PEqualNP.CircuitLowerBounds

/-- The point with ones exactly on `T`. -/
def ptOf {n : ℕ} (T : Finset (Fin n)) : Fin n → Bool := fun i => decide (i ∈ T)

/-- **A MergeSDR certificate**: zero points, their merge sets as literals, pairwise disjoint. -/
theorem mergeSDR_of_cert {n m : ℕ} (S : Fin m → Finset (Fin n)) (gates : List Gate)
    (z : Fin m → Fin n → Bool) (M : Fin m → Finset ℕ) (hz : ∀ w, ∀ v ∈ S w, z w v = false)
    (hM : ∀ w, mergeSet gates (S w) (z w) = M w)
    (hdisj : ∀ a b : Fin m, a ≠ b → Disjoint (M a) (M b)) : MergeSDR S gates :=
  ⟨z, hz, fun a b hab => by rw [hM a, hM b]; exact hdisj a b hab⟩

end PEqualNP.Outside.L_meta_951_aux
