import PEqualNP.AsteroidLang.Eval
/-!
# asteroid: the proof modules

For the claims marked `by lean` the executable writes two Lean files and has `lake build` check
them. The first, `PEqualNP/W951/Asteroid_<program>.lean`, holds each circuit as a literal and one
theorem per claim, proved by `decide +kernel`: the proof checker recomputes the verdict. The second,
`Asteroid_<program>_sound.lean`, restates those theorems in the project's own definitions through
the translation theorems of `W951/AsteroidSound.lean`, `AsteroidSound2.lean` and
`AsteroidCheap.lean`. The text is, byte for byte, what `asteroid/asteroid.py` writes, so both
versions share the files, the verifier and the documentation.
-/
namespace AsteroidLang
open Core

/-- a claim sent to the proof checker -/
structure LeanClaim where
  /-- the circuit it is about -/
  circ : String
  /-- the Lean statement -/
  stmt : String
  /-- the claim as written in the program -/
  text : String

/-- The Lean statements of a claim, each with its circuit. `none`: the claim has no Lean form. -/
def Expr.leanStatements (env : Env) : Expr → Option (List (String × String))
  | .correct c => some [(c, s!"correctB {c} = true")]
  | .hyps c want => some [(c, s!"hypsB {c} = {want}")]
  | .forallCubes c => some [(c, s!"slackNonnegAll {c} = true")]
  | .cmp (.app f c) op r =>
    let rv := (r.eval env).getD 0
    let (isInt, isBase) :=
      match r with
      | .int _ => (true, false)
      | .app g _ => (false, g == Func.base)
    if (f == Func.witness || f == Func.orwitness) && (isInt || isBase) then
      let fn := if f == Func.witness then "witnessCount" else "(fun C => orWitnessAt C 0)"
      some [(c, s!"{fn} {c} {op.lean} {rv}")]
    else if f == Func.slack && isInt && (op == Op.ge || op == Op.le || op == Op.eq) then
      let lower := (c, s!"slackGe {c} 0 ({rv}) = true")
      let upper := (c, s!"slackLe {c} 0 ({rv}) = true")
      some (if op == Op.ge then [lower] else if op == Op.le then [upper] else [lower, upper])
    else none
  | .cmp _ _ _ => none
  | .not _ => some []

/-- a list of numbers as `[0, 1, 2]` -/
def showNats (l : List Nat) : String := "[" ++ ", ".intercalate (l.map toString) ++ "]"

/-- the definition of a circuit in the proof module -/
def circLiteral (name : String) (C : Circ) : String :=
  let sets := "[" ++ ", ".intercalate (C.sets.map showNats) ++ "]"
  let gates := ", ".intercalate (C.gates.map fun g => s!"⟨{g.op}, {g.a}, {g.b}⟩")
  s!"def {name} : Circ := ⟨{C.n}, {sets}, {showNats C.outs}, [{gates}]⟩"

/-- the theorem names of the claims: the circuit, then the position of the claim -/
def theoremNames (claims : List LeanClaim) : List String :=
  claims.zipIdx.map fun (c, i) => s!"{c.circ}_claim{i}"

/-- **The proof module**: the circuits, and one theorem per claim by `decide +kernel`. -/
def proofModule (script mod : String) (env : Env) (claims : List LeanClaim) : String :=
  let imports := "import PEqualNP.W951.Asteroid" ::
    (if claims.any (·.stmt.startsWith "hypsB") then ["import PEqualNP.W951.AsteroidCheap"] else [])
  let header := [s!"/-! Generated by asteroid/asteroid.py from {script}. Do not edit.",
    "Statements about SearchCheck's bit-parallel evaluator (not yet tied to the project's \
      Circuit.eval). -/",
    s!"namespace SearchCheck.{mod}"]
  let circs := (claims.map (·.circ)).eraseDups.filterMap fun c =>
    (env[c]?).map (circLiteral c)
  let theorems := (claims.zip (theoremNames claims)).map fun (c, t) =>
    s!"/-- asteroid: `claim {c.text}` -/\ntheorem {t} : {c.stmt} := by decide +kernel"
  "\n".intercalate (imports ++ header ++ circs ++ theorems ++ [s!"end SearchCheck.{mod}"]) ++ "\n"

/-- the theorems of the second module for one claim; `t` is its theorem in the first module -/
def soundTheorems (t : String) (c : LeanClaim) : List (String × String) :=
  let n := c.circ
  let all := c.stmt.startsWith "slackNonnegAll"
  let project :=
    if c.stmt == s!"correctB {n} = true" then
      [(s!"{t}_project",
        s!"/-- `{c.text}`: the project's `Circuit.eval` computes the OR of every set. -/\n\
          theorem {t}_project (w_ : Fin {n}.sets.length) (x_ : Fin {n}.n → Bool) :\n    \
          Circuit.eval ⟨{n}.toGates, {n}.outs.getD w_ 0⟩ (List.ofFn x_) = \
          decide (∃ v_ ∈ {n}.setFin w_, x_ v_ = true) :=\n  \
          correctB_sound_project {n} {t} (by decide) w_ x_")]
    else if all then
      [(s!"{t}_project",
        s!"/-- `{c.text}`: base ≤ |F2| at every cube, in the project's definitions. -/\n\
          theorem {t}_project (Q_ : Finset (Fin {n}.n)) :\n    \
          baseDQ {n}.setFin ∅ Q_ ≤ (F2 {n}.toGates {n}.setFin Q_).card :=\n  \
          slackNonnegAll_sound {n} {n}_setsOk {t} Q_")]
    else []
  let continuous :=
    if all then
      [(s!"{t}_phi",
        s!"/-- the continuous form: the expected slack Φ(p) is nonnegative on [0, 1], in the \
          project's `Phi`. -/\n\
          theorem {t}_phi (p_ : ℝ) (h0_ : 0 ≤ p_) (h1_ : p_ ≤ 1) : \
          0 ≤ Phi {n}.toGates {n}.setFin p_ :=\n  \
          Phi_nonneg_of_slackNonnegAll {n} {n}_setsOk {t} h0_ h1_"),
       (s!"{t}_phi_zero",
        s!"/-- the line the remaining `{"so"}rry` asks for, for THIS circuit: 0 ≤ Φ(0). -/\n\
          theorem {t}_phi_zero : 0 ≤ Phi {n}.toGates {n}.setFin 0 :=\n  \
          Phi_nonneg_of_slackNonnegAll {n} {n}_setsOk {t} le_rfl zero_le_one")]
    else if c.stmt == s!"slackGe {n} 0 (0) = true" then
      [(s!"{t}_project",
        s!"/-- `{c.text}`: the sum of (|S| − 1) is at most the number of gates of this \
          circuit. -/\n\
          theorem {t}_project : ∑ w_, (({n}.setFin w_).card - 1) ≤ {n}.toGates.length :=\n  \
          base_le_gates_of_slackGe {n} {n}_setsOk {t}")]
    else []
  project ++ continuous

/-- does the second module need `NAME_setsOk` for this claim -/
def needsSetsOk (c : LeanClaim) : Bool :=
  c.stmt.startsWith "slackNonnegAll" || c.stmt == s!"slackGe {c.circ} 0 (0) = true"

/-- **The second module**: the claims in the project's own definitions, and the number of its
theorems. `none`: no claim of the program has a translation theorem. -/
def soundModule (mod : String) (claims : List LeanClaim) : Option (String × Nat) :=
  let header := [s!"import PEqualNP.W951.{mod}", "import PEqualNP.W951.AsteroidCheap",
    s!"/-! Generated by asteroid/asteroid.py. The claims of `{mod}` in the project's own \
      definitions. Do not edit. -/",
    "namespace SearchCheck", "open PEqualNP.CircuitLowerBounds (Circuit GateOp)",
    "open PEqualNP.Outside.L_meta_951_aux (F2 baseDQ MUF2 slack Phi Phi_zero)", s!"open {mod}",
    s!"namespace {mod}_sound"]
  let (body, made, _) := (claims.zip (theoremNames claims)).foldl
    (fun (acc : List String × Nat × List String) (c, t) =>
      let (body, made, done) := acc
      let ok := needsSetsOk c && !done.contains c.circ
      let setsOk := if ok then [s!"theorem {c.circ}_setsOk : Circ.SetsOk {c.circ} := by \
        unfold Circ.SetsOk; decide"] else []
      let ths := soundTheorems t c
      (body ++ setsOk ++ ths.map (·.2), made + ths.length,
        if ok then c.circ :: done else done))
    ([], 0, [])
  if made == 0 then none else
    some ("\n".intercalate (header ++ body ++ [s!"end {mod}_sound", "end SearchCheck"]) ++ "\n",
      made)

end AsteroidLang
