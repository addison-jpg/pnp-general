# c4mono_k3: 4 inputs, 4 sets, 25 gates, 0 NOT gates
INPUT(x0)
INPUT(x1)
INPUT(x2)
INPUT(x3)
OUTPUT(g21)
OUTPUT(g22)
OUTPUT(g23)
OUTPUT(g24)
#@ or g21 = x0 x1
#@ or g22 = x1 x2
#@ or g23 = x2 x3
#@ or g24 = x3 x0
g0 = AND(x1, x3)
g1 = AND(x0, x2)
g2 = OR(g0, g1)
g3 = AND(x0, x2)
g4 = AND(x1, x3)
g5 = OR(g3, g4)
g6 = AND(x0, x1)
g7 = AND(x1, x2)
g8 = AND(x0, x3)
g9 = AND(x2, x3)
g10 = OR(g6, g7)
g11 = OR(g10, g8)
g12 = OR(g11, g9)
g13 = OR(g5, g12)
g14 = AND(x1, x3)
g15 = OR(x0, x2)
g16 = OR(g15, g14)
g17 = AND(x0, x2)
g18 = OR(x1, g17)
g19 = OR(g18, x3)
g20 = OR(g16, g19)
g21 = OR(x0, x1)
g22 = OR(x1, x2)
g23 = OR(x2, x3)
g24 = OR(x3, x0)
