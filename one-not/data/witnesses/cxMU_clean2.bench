# cxMU_clean2: 7 inputs, 2 sets, 30 gates, 1 NOT gate
INPUT(x0)
INPUT(x1)
INPUT(x2)
INPUT(x3)
INPUT(x4)
INPUT(x5)
INPUT(x6)
OUTPUT(g25)
OUTPUT(g29)
#@ or g25 = x0 x1 x2 x3
#@ or g29 = x0 x4 x5 x6
g0 = OR(x0, x3)
