g4 = OR(x1, x4)
g5 = NOT(g4)
g6 = AND(x0, x2)
g7 = AND(g6, x5)
g8 = AND(x0, x3)
g9 = AND(g8, x6)
g10 = OR(x1, g7)
g11 = AND(g5, g10)
g12 = OR(x4, g9)
g13 = AND(g5, g12)
g14 = AND(x2, x4)
g15 = OR(g11, g14)
g16 = AND(x5, x1)
g17 = OR(g13, g16)
g18 = OR(g15, g17)
g19 = OR(x0, g18)
g20 = AND(g19, x2)
g21 = OR(g0, g20)
g22 = OR(x2, x4)
g23 = AND(g5, g22)
g24 = OR(g21, g23)
g25 = OR(g24, g1)
