# general_count_below_base_min: 7 inputs, 2 sets, 10 gates, 4 NOT gates
INPUT(x0)
INPUT(x1)
INPUT(x2)
INPUT(x3)
INPUT(x4)
INPUT(x5)
INPUT(x6)
OUTPUT(g3)
OUTPUT(g9)
#@ or g3 = x0 x1 x2 x3
#@ or g9 = x0 x4 x5 x6
g0 = NOT(x0)
g1 = OR(x0, x1)
g2 = OR(g1, x2)
g3 = OR(g2, x3)
g4 = OR(x4, x5)
g5 = NOT(g4)
g6 = NOT(x6)
g7 = AND(g6, g0)
g8 = AND(g5, g7)
g9 = NOT(g8)
