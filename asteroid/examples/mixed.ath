# Mixed slack: points fixed to 1 (Q) and to 0 (R). A circuit with ONE NOT gate that is read, in two ways.
# 1. loaded: n = 5, 9 gates, sets {0,3} {1,2,4} {2,3} {1,3}; the NOT gate (on input 2) feeds an AND.
let e = load one-not/data/witnesses/ess_rand_clean_744.circ.ath
show e
claim correct(e) by lean
claim nots(e) = 1
claim mslack(e, {}, {}) = 1 by lean   # the empty state: ordinary slack(e)
claim slack(e) = 1 by lean
claim mslack(e, {3}, {1}) >= 0 by lean
claim forall states mslack(e) >= 0 by lean
claim forall states mixedstep(e) by lean

# 2. written here: n = 4, x0 or x1 computed as x0 or (x1 and not x0); sets {0,1} and {0,2,3}.
circuit w 4
  nx = not 0
  t = and 1 nx
  a = or 0 t
  b = or 0 2
  c = or b 3
  set 0 1 -> a
  set 0 2 3 -> c
end
show w
claim correct(w) by lean
claim nots(w) = 1
claim forall states mslack(w) >= 0 by lean
claim forall states mixedstep(w) by lean
