# The witness count for any gate type falls below base with four NOT gates.
let c = load one-not/data/witnesses/nonlocal/general_count_below_base_min.circ.ath
let twin = load one-not/data/witnesses/twin_tree_f2step.circ.ath
let fano = load one-not/data/witnesses/fano_formula.circ.ath
show c
claim correct(c) by lean
claim nots(c) = 4
claim witness(c) = 5 by lean
claim witness(c) < base(c) by lean
claim margin["C4 count (flip classes)"](c) >= 0      # the repaired family holds on it
claim correct(fano) by lean
claim witness(fano) >= base(fano) by lean
claim slack(twin) >= 0
plot phi c twin fano -> asteroid/out/many_not.png
hunt "C4 count (flip classes)" 20 4 1 &
