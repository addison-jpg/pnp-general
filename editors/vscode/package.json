{
  "name": "asteroid",
  "displayName": "asteroid (.ath)",
  "description": "Syntax highlighting for asteroid (.ath) programs: circuits, claims, Lean proofs.",
  "version": "0.1.0",
  "publisher": "asteroid",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": { "type": "git", "url": "https://github.com/addison-jpg/pnp-general.git", "directory": "editors/vscode" },
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "keywords": ["asteroid", "ath", "circuits", "lean"],
  "contributes": {
    "languages": [{
      "id": "asteroid",
      "aliases": ["asteroid", "Asteroid"],
      "extensions": [".ath"],
      "configuration": "./language-configuration.json",
      "icon": { "light": "./images/icon.png", "dark": "./images/icon.png" }
    }],
    "grammars": [{
      "language": "asteroid",
      "scopeName": "source.asteroid",
      "path": "./syntaxes/asteroid.tmLanguage.json"
    }]
  },
  "scripts": { "test": "node test/tokenize.js" },
  "devDependencies": { "vscode-textmate": "9.0.0", "vscode-oniguruma": "2.0.1" }
}
