# math/language/: what can be proved of language. See math/language/BASE.md.
check "python3 -I math/language/check.py"
seq parses = run "python3 -I math/language/check.py" "parse trees of x op x"
seq dyck = from math/language/fingerprints.json "balanced parentheses"
seq catalan = from biology/brain/neuron/fingerprints.json "Catalan"
claim formula parses = "C(2*n - 2, n - 1) // n"     # Catalan(n-1) parse trees for n leaves
claim formula dyck = "C(2*n, n) // (n + 1)" from 0
claim parses matches catalan                       # join: parse-tree shapes = ordered arbor shapes (biology/brain/neuron)
seq first = from math/language/fingerprints.json "first disagreement"
claim first = [1, 2, 4]
